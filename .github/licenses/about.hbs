<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Leteo third-party licenses</title>
  <style>
    body { font: 16px system-ui, sans-serif; max-width: 70rem; margin: 2rem auto; padding: 0 1rem; }
    pre { white-space: pre-wrap; padding: 1rem; background: #f4f4f4; overflow-wrap: anywhere; }
  </style>
</head>
<body>
  <main>
    <h1>Leteo third-party licenses</h1>
    <p>This document contains license notices for Rust dependencies distributed with Leteo.</p>
    {{#each licenses}}
      {{#if first_of_kind}}<h2 id="{{id}}">{{name}}</h2>{{/if}}
      <h3>Used by</h3>
      <ul>
        {{#each used_by}}
          <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
        {{/each}}
      </ul>
      <pre>{{text}}</pre>
    {{/each}}
  </main>
</body>
</html>
