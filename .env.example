# Copy to .env and replace every value. The cloud service fails to start when
# any secret is missing, and each one must be at least 32 bytes and different
# from the others.
#
#   openssl rand -base64 48
#
# Never commit the filled-in .env.

POSTGRES_USER=leteo
POSTGRES_PASSWORD=replace-with-an-independent-database-password
POSTGRES_DB=leteo

LETEO_DASHBOARD_SECRET=replace-with-an-independent-32-byte-dashboard-secret
LETEO_CLOUD_TOKEN_PEPPER=replace-with-an-independent-32-byte-token-pepper

# Optional: pool size, published loopback port, and log level.
LETEO_CLOUD_MAX_POOL=10
LETEO_PUBLISH_PORT=8080
RUST_LOG=info
