# Container image for the MCP server.
#
# The sibling `Dockerfile` builds the *cloud* service — `leteo cloud serve`,
# an HTTP listener on 8080 against PostgreSQL — and says in its own first line
# that the local product needs no container. That is still true: the way to run
# this is a single binary writing to a SQLite file, and `leteo tui` sets an
# agent up in one screen.
#
# This one exists because directories that list MCP servers verify them by
# building an image and checking that it starts and answers an introspection
# request. Handed the sibling, that check gets an HTTP server that never reads
# stdin, and fails for a reason nobody can see from the outside. So the
# difference between the two files is the entrypoint, and the entrypoint is the
# whole point.
#
# It is built and *run* by CI on every pull request, which is not ceremony: the
# sibling shipped for weeks unbuildable, missing the `migrations` directory that
# `include_str!` needs, because nothing ever built it. An image nobody builds is
# a file that claims something.

FROM rust:1.97-bookworm AS build
WORKDIR /src

# rusqlite builds SQLite from source, so a C toolchain is required.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

# Cargo.lock is committed, so --locked keeps the image reproducible.
COPY Cargo.toml Cargo.lock ./
COPY src ./src
# The migrations are `include_str!`d into the binary rather than read at run
# time, so they are a build input and not data. This is the omission that kept
# the sibling image from ever building.
COPY migrations ./migrations
RUN cargo build --release --locked --bin leteo

FROM debian:bookworm-slim AS runtime

RUN useradd --system --create-home --uid 10001 leteo

COPY --from=build /src/target/release/leteo /usr/local/bin/leteo
COPY LICENSE NOTICE /usr/share/doc/leteo/

USER leteo
WORKDIR /home/leteo

# No port and no healthcheck. This speaks JSON-RPC over stdin and stdout, so
# `docker run -i` is the only way it is useful, and a container without an
# attached stdin is a container that will sit there answering nothing.
#
# The database lands in the default ~/.leteo, which is inside the image and
# therefore gone when the container is. Mount a volume there, or set
# LETEO_DATA_DIR, if the memories are meant to outlive the run.
ENTRYPOINT ["leteo", "mcp"]
